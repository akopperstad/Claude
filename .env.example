# Optional. Without it, Reface uses the offline heuristic audit + template redesign.
# With it, Reface adds an AI vision review and an AI-authored redesign.
ANTHROPIC_API_KEY=

# Optional: override the model used for AI review/redesign (default: claude-sonnet-4-6)
# REFACE_MODEL=claude-sonnet-4-6

# Optional: where the system Chromium lives (preset in this environment)
# PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# Field-testing: disable the daily render quota (founder machines only)
VOLING_UNLIMITED=1
